# ========================================================
# skidbladnir.conf - every setting and secret, in one file.
# deploy.sh reads it and gives the Pi only what it needs.
#
#   cp -n skidbladnir.conf.example skidbladnir.conf
#
# Git-ignored; keep a backup somewhere safe (it holds the
# Pi's password). Fill in every CHANGE_ME.
# ========================================================

# Login: the user you create in Raspberry Pi Imager. With the password
# here, deploy.sh installs its SSH key once and answers sudo itself.
# Pick a strong one: SSH listens on every network the Pi joins.
PI_USER="CHANGE_ME"
PI_PASSWORD="CHANGE_ME"

PI_NAME="skidbladnir"       # the hostname you set in Imager; also its Tailscale name
PI_HOST=""                  # how this PC reaches it; empty = <PI_NAME>.local

COUNTRY="CHANGE_ME"         # Wi-Fi country, ISO 3166 code, e.g. DE, FR, US

# Tailscale auth key (admin console > Settings > Keys), used only for the
# first login. Empty = the Pi prints a login link instead.
TS_AUTHKEY=""

# OpenWrt router the Pi plugs into at home, for "./deploy.sh router"
ROUTER="root@192.168.1.1"

# Filled in by "./deploy.sh pi --usb network". Kept here so a reflashed
# Pi gets the same MACs, and your router and laptop still recognize it.
PI_MAC=""
HOST_MAC=""
